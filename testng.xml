<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemoAutomationSuite" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="AuthenticationTests">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.LogoutTest"/>
        </classes>
    </test>

    <test name="InventoryTests">
        <classes>
            <class name="tests.InventorySortTest"/>
            <class name="tests.ProductDetailsTest"/>
        </classes>
    </test>

    <test name="CartTests">
        <classes>
            <class name="tests.CartTest"/>
            <class name="tests.CartStateNavigationTest"/>
        </classes>
    </test>

    <test name="CheckoutTest">
        <classes>
            <class name="tests.CheckoutTest"/>
        </classes>
    </test>

</suite>